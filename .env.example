# Copiar para .env (local) ou definir em Vercel → Settings → Environment Variables

# Base de dados Postgres (criada em Vercel → Storage; a integração define-a automaticamente)
DATABASE_URL=postgres://utilizador:senha@host:5432/base

# Painel /admin
ADMIN_PASSWORD=escolha-uma-palavra-passe-forte
APP_SECRET=texto-aleatorio-longo-com-pelo-menos-40-caracteres

# Email (servidor de correio do domínio cyscomp.co.ao, AngoWeb)
SMTP_HOST=ws4.angoweb.net
SMTP_PORT=465
SMTP_USER=info@cyscomp.co.ao
SMTP_PASS=palavra-passe-da-caixa-de-correio
MAIL_FROM=CYSCOMP <info@cyscomp.co.ao>
MAIL_INSCRICOES=info@cyscomp.co.ao
MAIL_CONTACTOS=comercial@cyscomp.co.ao

SITE_URL=https://www.cyscomp.co.ao
